# Copy this file to "deploy/.env" and fill in real values. NEVER commit ".env".
# NOTE (P0): variable names are kept identical to v1 so the code runs unchanged.
# They are replaced by per-service names in P2 (database users) and P5 (JWT RS256).

### JWT ###
# 64+ characters (HS512). Generate one with:  openssl rand -base64 64
JWT_SECRET=change-me-to-a-random-string-of-at-least-64-characters
# One day in milliseconds
JWT_EXPIRATION=86400000

### PostgreSQL ###
DB_USERNAME=postgres
DB_PASSWORD=change_me
# localhost URLs are for running services from IntelliJ; docker-compose overrides them
DB_URL_ACCOUNT=jdbc:postgresql://localhost:5433/nova_bank_account_db
DB_URL_TRANSACTION=jdbc:postgresql://localhost:5433/nova_bank_transaction_db
DB_URL_NOTIFICATION=jdbc:postgresql://localhost:5433/nova_bank_notification_db

### Gmail SMTP (use a Google App Password, not your normal password) ###
EMAIL_USERNAME=your_email@gmail.com
EMAIL_APP_PASSWORD=your_app_password
